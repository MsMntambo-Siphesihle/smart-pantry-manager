<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon for API 26+. The dark green solid colour is sampled from
     the source artwork so it blends seamlessly with the foreground image,
     whatever mask shape (circle, squircle, rounded square) the launcher
     applies. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
